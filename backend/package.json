{
  "name": "plank-challenge-backend",
  "version": "1.0.0",
  "description": "Plank Challenge API - Cloudflare Workers backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute plank-challenge-db --file=./src/db/schema.sql",
    "db:migrate:local": "wrangler d1 execute plank-challenge-db --local --file=./src/db/schema.sql",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "keywords": ["cloudflare", "workers", "fitness", "plank"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260313.1",
    "@hono/zod-validator": "^0.7.6",
    "@types/node": "^25.5.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "typescript": "^5.9.3",
    "wrangler": "^4.73.0",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "jose": "^6.2.1"
  }
}
